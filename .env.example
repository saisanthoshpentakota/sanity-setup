# Organization & Authentication
ORGANIZATION_UID=your-organization-uid
AUTH_TOKEN=your-auth-token

# API Configuration
API_URL=https://stag-personalize-api.csnonprod.com/
EDGE_API_URL=https://dev11-personalize-edge.csnonprod.com/
CMS_API_URL=https://dev11-api.csnonprod.com

# Project Configuration
LYTICS_ACCOUNT_ID=your-lytics-account-id
PERSONALIZE_PROJECT_ID=your-personalize-project-id

# Lytics API gateway, fronted by the main app - used to look up live Lytics
# segment/flow data (see LyticsGatewayService).
LYTICS_GATEWAY_URL=https://your-app-host/lytics-api/api-gateway/v2

# Uid of a project that already has a working Lytics connection. The gateway
# resolves the Lytics account/token to use from this project's connection.
LYTICS_PROJECT_UID=your-lytics-connected-project-uid

# Analytics Population Configuration
# Experience short UID for analytics population
ANALYTICS_EXP_SHORT_UID=0

# Variant short UID for analytics population
ANALYTICS_VARIANT_SHORT_UID=1

# Event key for metric tracking (ignore if only populating impressions)
ANALYTICS_EVENT_KEY=metric

# Number of impressions to populate
ANALYTICS_IMPRESSIONS=100

# Number of conversions to populate (ignore if only populating impressions)
ANALYTICS_CONVERSIONS=50

# Inline Targeting Fixtures Configuration (ECL-2252)
# The Lytics "all" audience uid and the "Sanity Flow" flow id are looked up
# live via LYTICS_GATEWAY_URL/LYTICS_PROJECT_UID above - see
# inline-targeting.constants.ts for the flow name/state constants.
