{
  "name": "setup-sanity",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap",
    "start": "npm run build && node dist/index.js",
    "setup": "npm run build && npm run start",
    "build-analytics-sanity": "tsup src/setup-analytics-sanity.ts --format cjs,esm --dts --sourcemap",
    "start-analytics-sanity": "node dist/setup-analytics-sanity.js",
    "setup-analytics-sanity": "npm run build-analytics-sanity && npm run start-analytics-sanity",
    "build-lytics-demo": "tsup src/setup-lytics-demo.ts --format cjs,esm --dts --sourcemap",
    "setup-lytics-demo": "node dist/setup-lytics-demo.js",
    "build-populate-analytics": "tsup src/populate-analytics.ts --format cjs,esm --dts --sourcemap",
    "populate-analytics": "npm run build-populate-analytics && node dist/populate-analytics.js",
    "build-inline-targeting-project": "tsup src/setup-inline-targeting-project.ts --format cjs,esm --dts --sourcemap",
    "setup-inline-targeting-project": "npm run build-inline-targeting-project && node dist/setup-inline-targeting-project.js",
    "build-inline-targeting-fixtures": "tsup src/setup-inline-targeting-fixtures.ts --format cjs,esm --dts --sourcemap",
    "setup-inline-targeting-fixtures": "npm run build-inline-targeting-fixtures && node dist/setup-inline-targeting-fixtures.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "nodemon": "^3.1.9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "neverthrow": "^8.2.0"
  }
}
